{
  "name": "mulemark",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:reset": "supabase db reset --local",
    "test:security": "npm run db:reset && vitest run --config vitest.security.config.ts",
    "test:rls": "vitest run --config vitest.security.config.ts tests/security/rls",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test tests/e2e/smoke",
    "test:e2e:critical": "playwright test --grep @critical",
    "test:e2e:reset": "supabase db reset --local",
    "verify:production-config": "node scripts/verify-production-config.mjs",
    "verify:tag-config": "node scripts/verify-tag-config.mjs",
    "verify:tag-config:production": "node --env-file-if-exists=.env.production-smoke.local scripts/verify-tag-config.mjs",
    "verify:local-target": "node scripts/verify-local-target.mjs",
    "verify:staging-target": "node scripts/verify-staging-target.mjs",
    "verify:production-target": "node scripts/verify-production-target.mjs",
    "verify:linked-project": "node scripts/check-linked-project.mjs",
    "staging:seed": "node scripts/staging/seed-staging-qa.mjs",
    "production:seed-qa": "node --env-file=.env.local --env-file-if-exists=.env.production-perf.local scripts/production/seed-production-qa.mjs",
    "staging:verify": "node --env-file=.env.staging.local scripts/staging/verify-staging-workflows.mjs",
    "staging:qa-password": "node --env-file=.env.staging.local scripts/staging/reset-staging-qa-passwords.mjs",
    "perf:baseline:production": "node --env-file-if-exists=.env.production-perf.local scripts/perf/baseline.mjs --env=production",
    "perf:timing:production": "node scripts/perf/collect-timing.mjs --env=production",
    "perf:baseline:staging": "node --env-file=.env.staging.local scripts/perf/baseline.mjs --env=staging",
    "smoke:staging": "node --env-file=.env.staging.local scripts/smoke/staging.mjs",
    "smoke:production": "node --env-file-if-exists=.env.production-smoke.local scripts/smoke/production.mjs",
    "qa:overflow": "node --env-file=.env.staging.local scripts/qa/measure-responsive-overflow.mjs",
    "qa:staging:data": "node --env-file=.env.staging.local scripts/qa/staging-qa-data.mjs",
    "qa:staging:devices": "node --env-file=.env.staging.local scripts/qa/staging-audit.mjs --devices",
    "qa:staging:loops": "node --env-file=.env.staging.local scripts/qa/staging-audit.mjs --loops",
    "qa:staging:qr": "node --env-file=.env.staging.local scripts/qa/staging-audit.mjs --qr",
    "qa:staging:vitals": "node --env-file=.env.staging.local scripts/qa/staging-vitals.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pg": "^8.22.0",
    "supabase": "^2.106.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
