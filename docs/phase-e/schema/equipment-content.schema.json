{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mulemark.io/schemas/phase-e/equipment-content-1.1.0.json",
  "title": "Mulemark equipment-content manifest",
  "description": "Versioned content contract shared by the showcase packs (E2) and customer onboarding batches (E4). Four layers: MODEL (exact configuration, sourced guidance), ASSET (customer facts), ORGANIZATION (customer settings and policies) and SOURCE/REVIEW (provenance, rights, applicability, review state). Guidance only exists on an identified model or as a sourced asset exception; a category never supplies model-specific instructions. Cross-reference rules JSON Schema cannot express are listed in docs/phase-e/ONBOARDING_DATA_CONTRACT.md and enforced by the E4B preflight. Draft-07 so any mainstream validator can check it. 1.1.0 (E2A) is additive: sourced specs, pictogram panels, a per-item READY/REVIEW_REQUIRED/BLOCKED status, photo credits and derivative files, and the source vault path and availability. Every 1.0.0 manifest is still valid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "kind", "organization", "sources", "models", "assets"],
  "properties": {
    "schema_version": { "enum": ["1.0.0", "1.1.0"] },
    "manifest_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "kind": { "enum": ["showcase", "customer-onboarding"] },
    "batch": { "$ref": "#/definitions/batch" },
    "organization": { "$ref": "#/definitions/organization" },
    "sources": { "type": "array", "items": { "$ref": "#/definitions/source" } },
    "models": { "type": "array", "items": { "$ref": "#/definitions/model" } },
    "assets": { "type": "array", "items": { "$ref": "#/definitions/asset" } },
    "approval": { "$ref": "#/definitions/approval" }
  },
  "definitions": {
    "reviewStatus": {
      "description": "Content review state. Separate from asset lifecycle (draft/public/archived) and rental state.",
      "enum": ["READY", "READY_WITH_WARNINGS", "CUSTOMER_INPUT_REQUIRED", "MULEMARK_REVIEW"]
    },
    "itemStatus": {
      "description": "1.1.0. State of one spec, step, panel or photo. READY = sourced and reviewed; REVIEW_REQUIRED = sourced but the knowledgeable review (or another named check) is outstanding; BLOCKED = a source, permission or fact is missing. A model cannot be READY while any of its items is REVIEW_REQUIRED or BLOCKED (checked by the pack tests).",
      "enum": ["READY", "REVIEW_REQUIRED", "BLOCKED"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/definitions/reviewStatus" },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "missing_facts": { "type": "array", "items": { "type": "string" } },
        "reviewer_role": { "type": "string" },
        "reviewed_at": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "READY" } }, "required": ["status"] },
          "then": { "properties": { "blockers": { "maxItems": 0 }, "warnings": { "maxItems": 0 }, "missing_facts": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "status": { "const": "READY_WITH_WARNINGS" } }, "required": ["status"] },
          "then": { "properties": { "blockers": { "maxItems": 0 } } }
        }
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "redistribution"],
      "properties": {
        "status": { "enum": ["owned", "cc0", "cc-by", "cc-by-sa", "oem-permission", "customer-supplied", "purchased-private", "unknown"] },
        "redistribution": {
          "description": "public-host = may be stored and served by Mulemark; link-only = link to the official copy; private-only = may inform private preparation, never shown; blocked = do not use.",
          "enum": ["public-host", "link-only", "private-only", "blocked"]
        },
        "shareable_across_orgs": { "type": "boolean" },
        "license_url": { "type": "string" },
        "attribution": { "type": "string" },
        "permission_ref": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "title", "rights", "verification"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
        "kind": { "enum": ["oem-manual", "oem-web", "oem-brochure", "oem-document", "photo", "illustration", "customer-file", "customer-statement"] },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string" },
        "url": { "type": "string" },
        "part_number": { "type": "string" },
        "edition": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "last_modified": { "type": "string" },
        "retrieved_at": { "type": "string" },
        "applicability": { "type": "string" },
        "rights": { "$ref": "#/definitions/rights" },
        "verification": {
          "description": "headers-only = existence/size/date checked, content not read; read = content reviewed; customer-confirmed = customer attested; unverified = not checked.",
          "enum": ["headers-only", "read", "customer-confirmed", "unverified"]
        },
        "availability": {
          "description": "1.1.0. in-hand = original bytes held (vault_path); to-purchase = sold only, not yet bought; permission-requested = waiting on the rights holder; unavailable = no lawful source found.",
          "enum": ["in-hand", "to-purchase", "permission-requested", "unavailable"]
        },
        "vault_path": { "description": "1.1.0. Path inside the private source vault (outside Git). Never a public URL.", "type": "string" },
        "locator_convention": { "description": "1.1.0. How locators cite pages, e.g. printed page numbers and the PDF offset.", "type": "string" }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id"],
      "properties": { "source_id": { "type": "string" }, "locator": { "type": "string" } }
    },
    "guidanceStep": {
      "description": "One instruction or warning. Never generic: it must cite at least one source (OEM document or customer policy) for this exact model or asset.",
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "text", "source_refs", "safety_critical"],
      "properties": {
        "step_id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "pictogram": { "type": "string" },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/sourceRef" } },
        "safety_critical": { "type": "boolean" },
        "reviewer_role": { "type": "string" },
        "status": { "$ref": "#/definitions/itemStatus" },
        "status_reason": { "type": "string" }
      }
    },
    "spec": {
      "description": "1.1.0. One published specification value, always with its source. Unknown values are listed as blockers, never estimated.",
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_id", "label", "value", "source_refs", "status"],
      "properties": {
        "spec_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/sourceRef" } },
        "status": { "$ref": "#/definitions/itemStatus" },
        "status_reason": { "type": "string" },
        "public": { "description": "false = kept for staff and review only (for example a capability a renter could misread as a limit).", "type": "boolean" }
      }
    },
    "credit": {
      "description": "1.1.0. Attribution for a photo or illustration (TASL: title via source, author, source, licence) and whether it was modified.",
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "license"],
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "license_url": { "type": "string" },
        "source_url": { "type": "string" },
        "modified": { "type": "boolean" },
        "modifications": { "type": "array", "items": { "type": "string" } }
      }
    },
    "mediaFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id"],
      "properties": {
        "source_id": { "type": "string" },
        "alt": { "type": "string" },
        "crop": { "type": "string" },
        "credit": { "$ref": "#/definitions/credit" },
        "files": { "type": "array", "items": { "$ref": "#/definitions/mediaFile" } },
        "status": { "$ref": "#/definitions/itemStatus" },
        "status_reason": { "type": "string" }
      }
    },
    "pageField": {
      "description": "1.1.0. One plain-text field of the public equipment page. derived_from names the steps, specs, warnings or customer policies (ids) it condenses, so citations stay in the review record instead of on the page.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "status"],
      "properties": {
        "text": { "type": ["string", "null"] },
        "derived_from": { "type": "array", "items": { "type": "string" } },
        "status": { "$ref": "#/definitions/itemStatus" },
        "status_reason": { "type": "string" }
      }
    },
    "page": {
      "description": "1.1.0. The seven equipment_pages text fields, in the app's display order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "quick_start_text", "safety_notes", "fuel_power_notes", "troubleshooting_notes", "return_notes", "emergency_notes"],
      "properties": {
        "headline": { "$ref": "#/definitions/pageField" },
        "quick_start_text": { "$ref": "#/definitions/pageField" },
        "safety_notes": { "$ref": "#/definitions/pageField" },
        "fuel_power_notes": { "$ref": "#/definitions/pageField" },
        "troubleshooting_notes": { "$ref": "#/definitions/pageField" },
        "return_notes": { "$ref": "#/definitions/pageField" },
        "emergency_notes": { "$ref": "#/definitions/pageField" }
      }
    },
    "plannedDocument": {
      "description": "1.1.0. A documents row the import will create: a link to an official copy, or a hosted file Mulemark owns or may host.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "document_type", "delivery", "visibility", "status"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "document_type": { "enum": ["manual", "startup_guide", "safety_sheet", "video", "return_checklist", "other"] },
        "delivery": { "enum": ["link", "hosted"] },
        "visibility": { "enum": ["public", "private"] },
        "url": { "type": "string" },
        "source_id": { "type": "string" },
        "file": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256"],
          "properties": {
            "file": { "type": "string" },
            "bytes": { "type": "integer", "minimum": 0 },
            "pages": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "status": { "$ref": "#/definitions/itemStatus" },
        "status_reason": { "type": "string" }
      }
    },
    "showcase": {
      "description": "1.1.0. Showcase assets only: the demo story, the sales narrative and the honest limit of what it shows.",
      "type": "object",
      "additionalProperties": false,
      "required": ["story", "narrative", "limitation"],
      "properties": {
        "story": { "type": "string" },
        "narrative": { "type": "string" },
        "limitation": { "type": "string" }
      }
    },
    "pictogramPanel": {
      "description": "1.1.0. One original pictographic panel. The storyboard fields are approved before artwork; files are added when the artwork exists. Controls are never mirrored or stylized: control_orientation states what is shown and from where, and anything the cited source does not show is left out.",
      "type": "object",
      "additionalProperties": false,
      "required": ["panel_id", "title", "task", "caption", "source_refs", "status"],
      "properties": {
        "panel_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "minLength": 1 },
        "caption": { "type": "string", "minLength": 1 },
        "alt": { "type": "string" },
        "text_alternative": { "type": "string" },
        "control_orientation": { "type": "string" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "interlocks": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/sourceRef" } },
        "safety_critical": { "type": "boolean" },
        "reviewer_checklist": { "type": "array", "items": { "type": "string" } },
        "files": { "type": "array", "items": { "$ref": "#/definitions/mediaFile" } },
        "status": { "$ref": "#/definitions/itemStatus" },
        "status_reason": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_key", "manufacturer", "model", "category", "configuration", "manual", "review"],
      "properties": {
        "model_key": { "description": "manufacturer.model.configuration, lowercase, e.g. bigtex.35sa.12", "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
        "manufacturer": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "category": { "description": "Label only. Never a source of guidance.", "type": "string" },
        "configuration": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serial_from": { "type": "string" },
            "serial_to": { "type": "string" },
            "model_years": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        "manual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "delivery"],
          "properties": {
            "source_id": { "type": "string" },
            "delivery": { "enum": ["hosted", "link"] },
            "supplements": { "type": "array", "items": { "type": "string" } }
          }
        },
        "specs": { "type": "array", "items": { "$ref": "#/definitions/spec" } },
        "quick_guide": { "type": "array", "items": { "$ref": "#/definitions/guidanceStep" } },
        "warnings": { "type": "array", "items": { "$ref": "#/definitions/guidanceStep" } },
        "pictograms": { "type": "array", "maxItems": 8, "items": { "$ref": "#/definitions/pictogramPanel" } },
        "support_notes": { "description": "1.1.0. Staff-facing answers to likely support requests, each sourced. Never shown on the public page.", "type": "array", "items": { "$ref": "#/definitions/guidanceStep" } },
        "storyboard": { "description": "1.1.0. Repository path of the generated human-readable storyboard.", "type": "string" },
        "templates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "return": { "type": "string" },
            "outbound": { "type": "string" },
            "equipment_page_seed": { "description": "Optional category seed for DRAFT text only; never published as-is.", "type": ["string", "null"] }
          }
        },
        "common_accessories": { "type": "array", "items": { "type": "string" } },
        "photo": { "$ref": "#/definitions/media" },
        "review": { "$ref": "#/definitions/review" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_code", "asset_name", "model_key", "review"],
      "properties": {
        "asset_code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "asset_name": { "type": "string", "minLength": 1 },
        "model_key": { "description": "null = model/configuration not established; no model-specific guidance may be published.", "type": ["string", "null"] },
        "category": { "type": "string" },
        "year": { "type": ["integer", "null"] },
        "serial_number": { "type": ["string", "null"] },
        "fitted_options": { "type": "array", "items": { "type": "string" } },
        "photo": { "$ref": "#/definitions/media" },
        "exceptions": { "type": "array", "items": { "$ref": "#/definitions/guidanceStep" } },
        "support_overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "phone": { "type": "string" }, "email": { "type": "string" } }
        },
        "qr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "existing_short_code": { "type": "string" },
            "protected": { "type": "boolean" }
          }
        },
        "existing_ids": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "asset_id": { "type": "string" }, "qr_link_id": { "type": "string" } }
        },
        "publish_intent": { "type": "boolean" },
        "page": { "$ref": "#/definitions/page" },
        "documents": { "type": "array", "items": { "$ref": "#/definitions/plannedDocument" } },
        "showcase": { "$ref": "#/definitions/showcase" },
        "review": { "$ref": "#/definitions/review" }
      },
      "if": { "properties": { "model_key": { "type": "null" } }, "required": ["model_key"] },
      "then": { "properties": { "review": { "properties": { "status": { "enum": ["CUSTOMER_INPUT_REQUIRED", "MULEMARK_REVIEW"] } } } } }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "support"],
      "properties": {
        "organization_id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "fictional": { "type": "boolean" },
        "logo": { "$ref": "#/definitions/media" },
        "primary_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "support": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "phone": { "type": "string" }, "email": { "type": "string" }, "hours": { "type": "string" } }
        },
        "notifications": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "return_mode": { "enum": ["instant_renter", "daily_exceptions", "off"] },
            "address_role": { "type": "string" }
          }
        },
        "policies": {
          "description": "Customer operating policies (deposits, accessories issued, fuel). Customer-owned statements, never OEM facts.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["policy_id", "text", "owner"],
            "properties": { "policy_id": { "type": "string" }, "text": { "type": "string" }, "owner": { "const": "customer" } }
          }
        },
        "approver": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "role": { "type": "string" }, "name_ref": { "description": "Reference to an access-controlled record; real names never live in Git.", "type": "string" } }
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "launch_scope"],
      "properties": {
        "batch_id": { "type": "string" },
        "launch_scope": { "enum": ["all", "partial"] },
        "included_asset_codes": { "type": "array", "items": { "type": "string" } },
        "excluded_asset_codes": { "type": "array", "items": { "type": "string" } },
        "research_minutes_per_model_cap": { "type": "integer", "minimum": 0 },
        "measurements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "batch_complete_at": { "type": "string" },
            "review_ready_at": { "type": "string" },
            "customer_wait_hours": { "type": "number", "minimum": 0 },
            "hands_on_minutes": { "type": "number", "minimum": 0 }
          }
        }
      },
      "if": { "properties": { "launch_scope": { "const": "partial" } }, "required": ["launch_scope"] },
      "then": { "required": ["included_asset_codes", "excluded_asset_codes"] }
    },
    "approval": {
      "description": "Affirmative operational content approval. Silence is never approval; approval is not a waiver.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["not_requested", "requested", "approved", "declined", "superseded"] },
        "content_version": { "type": "string" },
        "scope_asset_codes": { "type": "array", "items": { "type": "string" } },
        "approver_role": { "type": "string" },
        "approved_at": { "type": "string" },
        "record_ref": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
      "then": { "required": ["content_version", "scope_asset_codes", "approver_role", "approved_at", "record_ref"] }
    }
  }
}
