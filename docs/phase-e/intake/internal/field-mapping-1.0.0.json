{
  "mapping_version": "1.0.0",
  "workbook_version": "1.0",
  "description": "Customer intake workbook to Mulemark: labels customers see, stable keys, tiers and targets. Labels can change between versions; keys do not. Tiers: start = needed for a private draft import; golive = needed before go-live (review-ready); optional.",
  "unknown_answers": [
    "Not available",
    "Not sure",
    "Please review"
  ],
  "unknown_answer_meaning": {
    "Not available": "The fact or file does not exist or the customer cannot get it.",
    "Not sure": "The customer will check; asked again once, in the one consolidated request, if still needed.",
    "Please review": "Mulemark looks into it within the bounded research limit; unresolved items go back to the customer once."
  },
  "blank_answer": "Allowed anywhere. A blank optional answer stays blank; a blank answer needed before go-live is asked for once, in the one consolidated request.",
  "file_defaults": {
    "Photos/<asset code>/": "The customer's own photos; shown on the customer's own pages.",
    "Company/": "The logo; shown on the customer's own pages.",
    "Model documents/<model name>/": "Manuals follow 'May renters see the manual?' on MODELS. 'Your instructions for renters' files are shown on the customer's own pages.",
    "FILES & NOTES rows": "Only for files outside these folders, from the maker, or not for renters. A row can only restrict what a folder default allows.",
    "Never": "Shared with another company. Every source has shareable_across_orgs: false."
  },
  "layout": {
    "titleRow": 1,
    "noteRow": 2,
    "bandRow": 3,
    "labelRow": 4,
    "hintRow": 5,
    "firstDataRow": 6,
    "company_form_columns": [
      "Needed",
      "Question",
      "Your answer",
      "Help"
    ]
  },
  "lists": {
    "unknown": [
      "Not available",
      "Not sure",
      "Please review"
    ],
    "yesNo": [
      "Yes",
      "No"
    ],
    "yesNoNotSure": [
      "Yes",
      "No",
      "Not sure"
    ],
    "role": [
      "Administrator",
      "Staff"
    ],
    "returnEmails": [
      "Each renter return + daily staff exceptions",
      "Daily exceptions summary",
      "Off"
    ],
    "tag": [
      "New tag",
      "Already has a Mulemark tag",
      "No tag for now"
    ],
    "assetPhoto": [
      "In Photos folder",
      "Use model photo",
      "No photo yet"
    ],
    "modelPhoto": [
      "Use asset photos",
      "Not available",
      "Not sure",
      "Please review"
    ],
    "model": [
      "Not available",
      "Not sure",
      "Please review"
    ],
    "manual": [
      "Not available",
      "Not sure",
      "Please review"
    ],
    "manualShare": [
      "Link to the maker's copy",
      "Show our copy",
      "Staff only",
      "Not sure"
    ],
    "photoPermission": [
      "We took it",
      "Maker's photo, permitted",
      "Not sure"
    ],
    "fuel": [
      "Diesel",
      "Gasoline",
      "Propane",
      "Electric (plug-in)",
      "Battery",
      "None",
      "Not sure"
    ],
    "fileKind": [
      "Photo",
      "Manual",
      "Your instructions",
      "Logo",
      "Other"
    ],
    "fileSource": [
      "We made it or took it",
      "From the maker",
      "Not sure"
    ],
    "fileAudience": [
      "Renters, on our pages",
      "Staff only",
      "Not sure"
    ],
    "category": [
      "Mini excavator",
      "Compact excavator",
      "Skid steer",
      "Utility trailer",
      "Equipment trailer",
      "Dump trailer",
      "Portable generator",
      "Towable generator",
      "Plate compactor",
      "Scissor lift",
      "Air compressor",
      "Electrical test equipment"
    ],
    "tagMounting": [
      "Adhesive",
      "Rivet",
      "Screw",
      "Zip tie",
      "Other",
