  "tabs": [
    {
      "tab": "CALL SHEET",
      "sections": [
        {
          "title": "Before the call: from their website (confirm on the call)",
          "fields": [
            {
              "key": "company.name",
              "label": "Company name (as renters see it)",
              "tier": "start",
              "type": "text",
              "hint": "e.g. Northridge Rentals",
              "targets": {
                "contract": "organization.name",
                "app": "organizations.name"
              }
            },
            {
              "key": "company.website",
              "label": "Website",
              "tier": "optional",
              "type": "url",
              "hint": "https://…",
              "targets": {
                "app": "organizations.website_url",
                "kit_only": "The content contract has no website field."
              }
            },
            {
              "key": "company.logo_file",
              "label": "Logo file",
              "tier": "optional",
              "type": "text",
              "hint": "Saved in inbox\\Company\\. PNG or JPG; a design file (.ai, .eps, .svg) is fine, it gets converted.",
              "targets": {
                "contract": "organization.logo",
                "app": "organizations.logo_url (uploaded by Mulemark)"
              }
            },
            {
              "key": "company.brand_color",
              "label": "Brand color",
              "tier": "optional",
              "type": "choice+text",
              "list": "brandColor",
              "hint": "A color like #1D4ED8, or Match our logo.",
              "targets": {
                "contract": "organization.primary_color",
                "app": "organizations.primary_color"
              }
            },
            {
              "key": "company.support_phone",
              "label": "Support phone renters see",
              "tier": "golive",
              "type": "phone",
              "hint": "Phone, email or both: at least one. A normal phone number gets a Call button.",
              "targets": {
                "contract": "organization.support.phone",
                "app": "organizations.support_phone"
              }
            },
            {
              "key": "company.support_email",
              "label": "Support email renters see",
              "tier": "golive",
              "type": "email",
              "hint": "Phone, email or both: at least one.",
              "targets": {
                "contract": "organization.support.email",
                "app": "organizations.support_email"
              }
            },
            {
              "key": "rules.fuel",
              "label": "Their rule: fuel or charge on return",
              "tier": "optional",
              "type": "text",
              "hint": "From their website or the call. Short: what renters must do, e.g. Return with a full tank.",
              "targets": {
                "contract": "organization.policies[] (customer-owned)",
                "app": "equipment_pages.fuel_power_notes / return_notes (drafted, cited as their rule)"
              }
            },
            {
              "key": "rules.cleaning",
              "label": "Their rule: cleaning",
              "tier": "optional",
              "type": "text",
              "hint": "e.g. Return clean or a cleaning fee applies.",
              "targets": {
                "contract": "organization.policies[] (customer-owned)",
                "app": "equipment_pages.return_notes (drafted)"
              }
            },
            {
              "key": "rules.accessories",
              "label": "Their rule: accessories",
              "tier": "optional",
              "type": "text",
              "hint": "e.g. Everything sent out comes back.",
              "targets": {
                "contract": "organization.policies[] (customer-owned)",
                "app": "equipment_pages.return_notes (drafted)"
              }
            },
            {
              "key": "rules.damage_late",
              "label": "Their rule: damage and late returns",
              "tier": "optional",
              "type": "text",
              "hint": "e.g. Report damage right away with the Report button.",
              "targets": {
                "contract": "organization.policies[] (customer-owned)",
                "app": "equipment_pages.return_notes (drafted)"
              }
            },
            {
              "key": "rules.other",
              "label": "Other rules renters must know",
              "tier": "optional",
              "type": "text",
              "hint": "Only what renters must do; never their rental agreement.",
              "targets": {
                "contract": "organization.policies[] (customer-owned)",
                "app": "equipment_pages (drafted, cited as their rule)"
              }
            }
          ]
        },
        {
          "title": "Ask on the call (in this order; people go in the table on the right)",
          "fields": [
            {
              "key": "company.support_hours",
              "label": "Support hours",
              "tier": "optional",
              "type": "text",
              "hint": "e.g. Mon–Fri 7 am–5 pm. Shown in each page's support section.",
              "targets": {
                "contract": "organization.support.hours",
                "app": "equipment_pages.emergency_notes (drafted by Mulemark; no hours column)"
              }
            },
            {
              "key": "approver.name",
              "label": "Who approves the pages: name",
              "tier": "golive",
              "type": "text",
              "hint": "Gets the preview email and replies Approved.",
              "targets": {
                "contract": "organization.approver.name_ref (reference only; the name stays in private storage)",
                "app": "approval record (E5A)"
              }
            },
            {
              "key": "approver.title",
              "label": "Approver's job title",
              "tier": "golive",
              "type": "text",
              "hint": "e.g. Operations manager",
              "targets": {
                "contract": "organization.approver.role",
                "app": "approval record (E5A)"
              }
            },
            {
              "key": "approver.email",
              "label": "Approver's email",
              "tier": "golive",
              "type": "email",
              "hint": "The preview email goes here.",
              "targets": {
                "app": "profiles.email (invited as Administrator)",
                "kit_only": "Manifests never hold real names or addresses."
              }
            },
            {
              "key": "alerts.notification_email",
              "label": "Where renter reports go (one email)",
              "tier": "golive",
              "type": "email",
              "hint": "Damage and support reports and the daily summary.",
              "targets": {
                "contract": "organization.notifications.address_role",
                "app": "organizations.notification_email"
              }
            },
            {
              "key": "alerts.urgent_email",
              "label": "Urgent reports also to (one email)",
              "tier": "optional",
              "type": "email",
              "hint": "Reports marked unsafe to use or can't move also go here. Blank: no copy.",
              "targets": {
                "app": "organizations.urgent_notification_email (+ notify_urgent_reports)",
                "kit_only": "Not in the content contract."
              }
            },
            {
              "key": "tags.ship_to",
              "label": "Ship tags to",
              "tier": "golive",
              "type": "text",
              "hint": "Street, city, province or state, postal code. Needed before tags are made.",
              "targets": {
                "kit_only": "Tag requests have no shipping address; used on the tag order."
              }
            },
            {
              "key": "tags.contact",
              "label": "Tag delivery contact",
              "tier": "optional",
              "type": "text",
              "hint": "Name and phone for the courier.",
              "targets": {
                "kit_only": "Tag requests have no delivery contact; used on the tag order."
              }
            }
          ]
        },
        {
          "title": "Defaults: blank keeps the app's setting",
          "fields": [
            {
              "key": "alerts.damage",
              "label": "Email damage reports",
              "tier": "optional",
              "type": "choice",
              "list": "yesNo",
              "hint": "Blank: Yes.",
              "targets": {
                "app": "organizations.notify_damage_reports",
                "kit_only": "Not in the content contract."
              }
            },
            {
              "key": "alerts.support",
              "label": "Email support requests",
              "tier": "optional",
              "type": "choice",
              "list": "yesNo",
              "hint": "Blank: Yes.",
              "targets": {
                "app": "organizations.notify_support_requests",
                "kit_only": "Not in the content contract."
              }
            },
            {
              "key": "alerts.return_mode",
              "label": "Return emails",
              "tier": "optional",
              "type": "choice",
              "list": "returnEmails",
              "hint": "Blank: Off. Renters can fill a return checklist on the page.",
              "targets": {
                "contract": "organization.notifications.return_mode",
                "app": "organizations.return_notification_mode"
              }
            },
            {
              "key": "alerts.tag_updates",
              "label": "Email tag order updates",
              "tier": "optional",
              "type": "choice",
              "list": "yesNo",
              "hint": "Blank: No.",
              "targets": {
                "app": "organizations.notify_tag_request_updates",
                "kit_only": "Not in the content contract."
              }
            },
            {
              "key": "alerts.photo_previews",
              "label": "Photo previews in emails",
              "tier": "optional",
              "type": "choice",
              "list": "yesNo",
              "hint": "Blank: Yes. Small copies of the renter's photos inside the email.",
              "targets": {
                "app": "organizations.notify_include_photo_previews",
                "kit_only": "Not in the content contract."
              }
            },
            {
              "key": "tags.mounting",
              "label": "How tags attach",
              "tier": "optional",
              "type": "choice",
              "list": "tagMounting",
              "hint": "Blank or Not sure: recommend one.",
              "targets": {
                "app": "tag_requests.mounting_method",
                "kit_only": "Not in the content contract."
              }
            },
            {
              "key": "tags.size",
              "label": "Tag size",
              "tier": "optional",
              "type": "choice",
              "list": "tagSize",
              "hint": "Blank or Not sure: as the agreement sets.",
              "targets": {
                "app": "tag_requests.tag_size",
                "kit_only": "Not in the content contract."
              }
            },
            {
              "key": "tags.material",
              "label": "Tag material",
              "tier": "optional",
              "type": "choice",
              "list": "tagMaterial",
              "hint": "Blank or Not sure: as the agreement sets.",
              "targets": {
                "app": "tag_requests.material",
                "kit_only": "Not in the content contract."
              }
            }
          ]
        },
        {
          "title": "Dates and time (this batch)",
          "fields": [
            {
              "key": "batch.complete_on",
              "label": "Everything in (list and call answers)",
              "tier": "optional",
              "type": "date",
              "hint": "The day the batch was complete: the 3-business-day target starts here.",
              "targets": {
                "contract": "batch.measurements.batch_complete_at"
              }
            },
            {
              "key": "batch.preview_sent_on",
              "label": "Preview sent",
              "tier": "optional",
              "type": "date",
              "hint": "The day the preview email went out (review-ready).",
              "targets": {
                "contract": "batch.measurements.review_ready_at"
              }
            },
            {
              "key": "batch.approved_on",
              "label": "Approved",
              "tier": "optional",
              "type": "date",
              "hint": "The day of their Approved reply; save the reply in the batch folder.",
              "targets": {
                "kit_only": "The approval record itself is E5A's."
              }
            },
            {
              "key": "batch.live_on",
              "label": "Live",
              "tier": "optional",
              "type": "date",
              "hint": "The day the pages went live.",
              "targets": {
                "kit_only": "Recorded for the batch; not a contract field."
              }
            },
            {
              "key": "batch.hands_on_minutes",
              "label": "Hands-on minutes (Mulemark)",
              "tier": "optional",
              "type": "number",
              "hint": "Total for this batch: call, research, pages, emails.",
              "targets": {
                "contract": "batch.measurements.hands_on_minutes"
              }
            },
            {
              "key": "batch.customer_wait_hours",
              "label": "Hours waiting on the customer",
              "tier": "optional",
              "type": "number",
              "hint": "Optional: from a question to their answer.",
              "targets": {
                "contract": "batch.measurements.customer_wait_hours"
              }
            }
          ]
        }
      ],
      "people": [
        {
          "key": "people.name",
          "label": "Name",
          "tier": "golive",
          "type": "text",
          "width": 24,
          "hint": "One Administrator is enough to start; they can add the rest.",
          "targets": {
            "app": "profiles.name"
          }
        },
        {
          "key": "people.email",
          "label": "Email",
          "tier": "golive",
          "type": "email",
          "width": 30,
          "hint": "Each person signs in with their own. Any address they read works.",
          "targets": {
            "app": "profiles.email"
          }
        },
        {
          "key": "people.role",
          "label": "Role",
          "tier": "golive",
          "type": "choice",
          "list": "role",
          "width": 24,
          "hint": "Administrator: settings, team, approval. Staff: equipment, reports, rentals.",
          "targets": {
            "app": "profiles.role (customer_admin / customer_staff)"
          }
        },
        {
          "key": "people.notes",
          "label": "Notes",
          "tier": "optional",
          "type": "text",
          "width": 26,
          "hint": "e.g. Yard lead",
          "targets": {
            "kit_only": "Never published."
          }
        }
      ]
    },
    {
      "tab": "MODELS",
      "rows": 200,
      "columns": [
        {
          "key": "model.name",
          "label": "Model name (short)",
          "tier": "golive",
          "type": "text",
          "width": 26,
          "hint": "Each machine on ASSETS uses this name, e.g. Big Tex 14LP dump",
          "targets": {
            "contract": "models[].model_key (derived from make, model and version)",
            "kit_only": "The join between ASSETS and MODELS."
          }
        },
        {
          "key": "model.make",
          "label": "Make",
          "tier": "golive",
          "type": "text",
          "width": 16,
          "hint": "e.g. Big Tex",
          "targets": {
            "current_import": "make",
            "contract": "models[].manufacturer",
            "app": "assets.make"
          }
        },
        {
          "key": "model.model",
          "label": "Model",
          "tier": "golive",
          "type": "text",
          "width": 14,
