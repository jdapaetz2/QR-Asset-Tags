      "email": "rentals@example.com",
      "hours": "Mon–Fri 7 am–5 pm, Sat 8 am–noon"
    },
    "notifications": {
      "return_mode": "daily_exceptions",
      "address_role": "the notification email on COMPANY & PEOPLE"
    },
    "policies": [
      {
        "policy_id": "pol-fuel",
        "text": "Return with a full tank, or we refuel at the posted rate.",
        "owner": "customer"
      },
      {
        "policy_id": "pol-cleaning",
        "text": "Return clean. Hose off mud before you bring it back.",
        "owner": "customer"
      },
      {
        "policy_id": "pol-accessories",
        "text": "Everything we send out comes back: straps, pins, remotes and keys.",
        "owner": "customer"
      },
      {
        "policy_id": "pol-damage-late",
        "text": "Report damage right away with the Report button on the tag page.",
        "owner": "customer"
      },
      {
        "policy_id": "pol-other",
        "text": "Call us before moving a machine to a different job site.",
        "owner": "customer"
      },
      {
        "policy_id": "pol-bigtex-35sa-12-return",
        "text": "Return swept out, with the straps rolled up.",
        "owner": "customer"
      },
      {
        "policy_id": "pol-bigtex-14lp-14-return",
        "text": "Return with the bed empty and lowered.",
        "owner": "customer"
      },
      {
        "policy_id": "pol-bobcat-e20-b3bl-canopy-return",
        "text": "Return with a full tank and the bucket scraped clean.",
        "owner": "customer"
      },
      {
        "policy_id": "pol-caterpillar-301-5-canopy-return",
        "text": "Return with a full tank.",
        "owner": "customer"
      }
    ],
    "approver": {
      "role": "Operations manager",
      "name_ref": "intake workbook, COMPANY & PEOPLE, Approver's name (private storage)"
    },
    "primary_color": "#1F5C3A",
