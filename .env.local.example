# Copy to .env.local and fill in. NEVER commit real secrets.
# Every variable below is actually read by lib/env.ts. See docs/CODE_HANDOFF.md
# "Environment variables". Storage bucket names are hard-coded in code (not
# configurable), and the public-form honeypot is a fixed internal field
# (`company_website`) — so neither is an environment variable.

# Supabase (public — safe in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (SERVER ONLY — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used to build permanent QR URLs (the /t/{short_code} host).
# PRODUCTION-DOMAIN-SENSITIVE: physical tags encode this value permanently, so
# production must be the final stable host — never localhost or a *.vercel.app
# preview (blocked from tag production by isProductionBaseUrl).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Salt for hashing scan-event IPs (server only; never store raw IPs).
# Currently FAILS SOFT: if empty, IP hashing still runs but with weaker
# anonymization and no error. Phase A5 will require this in production.
SCAN_IP_HASH_SALT=

# Notification email (server only). Leave BOTH blank to run notifications in
# dry-run mode (logged, never sent). Provider: Resend (REST API, no SDK).
# NOTIFICATION_FROM_EMAIL must be a Resend-verified sender, e.g.
# "Mulemark Alerts <alerts@yourdomain.com>".
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Public-submission rate limiting is NOT yet implemented (honeypot only today).
# Phase A4 defines the real shared-store rate-limit configuration; no dead
# rate-limit variables are declared here in the meantime.
